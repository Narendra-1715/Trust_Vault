# TrustVault Environment Configuration (Hackathon Edition)
# Use this file as a template for local development or staging.

# Environment Settings
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="TrustVault"
VERSION="1.0.0"

# Cryptographic Secret (Replace with a random 32-byte hex string in production)
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production

# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite:///./data/trustvault.db
# PostgreSQL example for production / Docker:
# DATABASE_URL=postgresql+psycopg://trustvault_admin:trustvault_pass@localhost:5432/trustvault_prod

# Private Storage Configuration
# Supported backends: 'local' (filesystem volume) or 's3' (S3-compatible object storage)
STORAGE_BACKEND=local
STORAGE_DIR=./data/vault_storage
MAX_FILE_SIZE_MB=25

# S3-Compatible Cloud Storage (Optional - used when STORAGE_BACKEND=s3)
# Compatible with Supabase Storage, Cloudflare R2, AWS S3, or MinIO
S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
S3_BUCKET_NAME=trustvault-storage
S3_ACCESS_KEY_ID=your_s3_access_key_id_placeholder
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_placeholder
S3_REGION_NAME=us-east-1

# AI Access Recommendations (Advisory metadata analysis)
# 'mock' for offline deterministic testing; 'gemini' for live Google Gemini API
AI_PROVIDER=mock
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Demonstration Fixtures
# In development, set to true to seed demo accounts. In production, defaults to false.
SEED_DEMO_DATA=false

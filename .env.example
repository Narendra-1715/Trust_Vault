# TrustVault Environment Configuration

# Environment
ENVIRONMENT=development
DEBUG=false

# Security (Replace with a cryptographically random string in production)
SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production

# Database (PostgreSQL for production/docker, SQLite for standalone local testing)
# Example PostgreSQL: postgresql+psycopg://trustvault:trustvault_pass@localhost:5432/trustvault
DATABASE_URL=sqlite:///./data/trustvault.db

# Storage Path (Outside public web root)
STORAGE_DIR=./data/vault_storage

# AI Provider Configuration
# Set AI_PROVIDER to 'gemini' (requires GEMINI_API_KEY) or 'mock' for local offline testing
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Docker credentials
POSTGRES_USER=trustvault
POSTGRES_PASSWORD=trustvault_secure_pass_2026
POSTGRES_DB=trustvault

# ==============================================================================
# TRUSTVAULT PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env on your production host before launching containers
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false

# Cryptographic Secret Key (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate_a_random_64_character_hex_string_here_for_production

# PostgreSQL Database Credentials
POSTGRES_USER=trustvault_admin
POSTGRES_PASSWORD=replace_with_a_strong_database_password_2026
POSTGRES_DB=trustvault_prod

# Full SQLAlchemy Database Connection String
DATABASE_URL=postgresql+psycopg://trustvault_admin:replace_with_a_strong_database_password_2026@postgres:5432/trustvault_prod

# Private Storage Volume (Absolute path inside container)
STORAGE_DIR=/app/data/vault_storage

# Google Gemini AI Provider Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_production_gemini_api_key_here

# Allowed Frontend Origins (Comma-separated, or * if using unified reverse proxy)
BACKEND_CORS_ORIGINS=*
